@css {
    .input-base {
        @apply  .shadow .appearance-none .border .rounded .py-2 .mb-2 .px-3 .text-grey-darker .leading-tight .w-full;


        &:focus{
            @apply .outline-none .shadow-outline;
        }
    }
    .label-base{
        @apply .block .text-grey-darker .text-sm .font-bold .mb-2;
    }
    .error-base{
    @apply .text-red .text-xs .italic;
    }
}
input.vdatetime-input {
    width: 100%;
    height: 100%;
}
